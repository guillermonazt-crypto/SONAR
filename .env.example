# SONAR · copia este archivo a .env y completa los valores.
# Nunca subas .env a Git.

# --- Django ---
SECRET_KEY=
# true sólo en desarrollo local (runserver). En producción déjalo en false.
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,10.128.3.139
# En producción usa el nombre HTTPS real, p. ej. https://sonar.uaeh.edu.mx
DJANGO_CSRF_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://10.128.3.139:5173
# sqlite (desarrollo) o postgres (docker-compose lo fija en postgres)
DJANGO_DB_ENGINE=sqlite
POSTGRES_DB=sonar
POSTGRES_USER=sonar
POSTGRES_PASSWORD=

# --- SNMP (worker) ---
# 2c usa SNMP_COMMUNITY. 3 usa usuario USM con autenticación y cifrado (recomendado).
SNMP_VERSION=2c
SNMP_COMMUNITY=
SNMP_V3_USER=
SNMP_V3_AUTH_KEY=
SNMP_V3_PRIV_KEY=
# sha, sha256 o sha512 / aes o aes256
SNMP_V3_AUTH_PROTOCOL=sha
SNMP_V3_PRIV_PROTOCOL=aes
SNMP_TIMEOUT=2
SNMP_RETRIES=3
# Switches consultados a la vez por ciclo
SNMP_CONCURRENCY=20
POLL_INTERVAL_SECONDS=60
INVENTORY_SOURCE=django

# --- InfluxDB ---
INFLUX_URL=http://localhost:8086
INFLUX_ORG=universidad
INFLUX_BUCKET=red_universitaria
INFLUX_ADMIN_USER=sonar_admin
INFLUX_ADMIN_PASSWORD=
# Token de escritura del worker (y admin inicial de docker-compose)
INFLUX_TOKEN=
# Token de sólo lectura para Django (lo crea scripts/setup_influx_downsampling.py)
INFLUX_READ_TOKEN=
# Bucket para Reportes → Tendencias (7/30 días). Por defecto <INFLUX_BUCKET>_15m y, si no existe, el crudo.
# INFLUX_TREND_BUCKET=

# --- Grafana ---
GRAFANA_ADMIN_PASSWORD=

# --- HTTPS (docker-compose) ---
SONAR_HOSTNAME=sonar.local
# Carpeta con sonar.crt y sonar.key reales; si se omite, se genera uno autofirmado
# SONAR_CERTS_DIR=./deploy/certs

# --- Alertas (opcionales; sin valores no se envía nada) ---
ALERT_COOLDOWN_MINUTES=30
ALERT_EMAIL_TO=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=sonar@localhost
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Webhook entrante de Teams, Slack o Google Chat
ALERT_WEBHOOK_URL=
# Escalamiento: correos que además reciben las alertas que siguen sin reconocer
# después de "Minutos para escalar" (admin → Umbrales por rol; core 15, distribución 30, acceso 60).
ALERT_ESCALATION_EMAIL_TO=

# --- Zabbix (opcional) ---
ZABBIX_URL=
ZABBIX_TOKEN=

# --- Descubrimiento de equipos (opcional, apagado por defecto) ---
# Propone equipos fuera del inventario: vecinos CDP y, si hay subredes, un
# barrido SNMP (sysName/sysDescr). Nunca los agrega solos: un editor decide.
DISCOVERY_ENABLED=false
# Subredes a barrer separadas por coma, p. ej. 192.168.27.0/24,10.10.0.0/24
DISCOVERY_SUBNETS=
DISCOVERY_INTERVAL_HOURS=24
# Tope de IPs por pasada para no barrer una red enorme por error
DISCOVERY_MAX_HOSTS=1024
DISCOVERY_CONCURRENCY=32

# --- Respaldo de configuraciones por SSH (opcional, apagado por defecto) ---
# Requiere: pip install paramiko. Usa un usuario de sólo lectura.
BACKUP_ENABLED=false
BACKUP_INTERVAL_HOURS=24
BACKUP_SSH_USER=
BACKUP_SSH_PASSWORD=
# Alternativa a la contraseña: ruta a una llave privada
BACKUP_SSH_KEY_FILE=
BACKUP_SSH_PORT=22
# Recomendado: archivo known_hosts; con él se rechazan llaves desconocidas
BACKUP_SSH_KNOWN_HOSTS=
BACKUP_TIMEOUT=30
BACKUP_COMMAND=show running-config
