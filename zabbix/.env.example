# Zabbix para SONAR · copia este archivo a zabbix/.env y completa los valores.
# Nunca subas .env a Git.
ZBX_POSTGRES_DB=zabbix
ZBX_POSTGRES_USER=zabbix
# Obligatoria: docker compose no arranca sin ella.
ZBX_POSTGRES_PASSWORD=
# Puertos publicados en el equipo
ZBX_HTTP_PORT=8090
ZBX_SERVER_PORT=10051
ZBX_TRAPS_PORT=162
# Para init_zabbix.py
ZBX_URL=http://localhost:8090
# Nueva contraseña de Admin (mínimo 8). init_zabbix.py reemplaza "zabbix" con ésta.
ZBX_ADMIN_PASSWORD=
# Comunidad SNMP v2c de los switches (se guarda como macro global secreta).
# Si se omite se usa SNMP_COMMUNITY del .env de SONAR.
ZBX_SNMP_COMMUNITY=
